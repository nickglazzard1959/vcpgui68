COMMENT
Routines for controlling a Rigol 3K series DMM over USBTMC.
===========================================================

A subset of commands (hopefully the most useful) for a Rigol DM3000
series multi-meter are implemented. This has been tested with a DM3058E on
Debian Linux.

This uses the Rigol command set (the multi-meters also support Agilent and
Fluke command sets - presumably as used by those brands). The Agilent set 
seems very similar, so it might be easy to adapt this to work with Agilent
devices. The Fluke set seems quite different, though.


Nick Glazzard 2026
------------------
COMMENT

PR read "tmcusbio.a68" PR

# Try to keep as much information about the device as possible in a table. #
# It turns out that the range is entirely function dependent - each function tracks its own range. #
INT k_rn = 7;  # Maximum number of ranges for any function. #
INT k_nn = 3;  # Maximum number of alternative names for any function. #
MODE FUNCDESC = STRUCT( [k_nn]STRING names, STRING cmd, INT n_range, [k_rn]STRING rangenames, [k_rn]STRING resolutions );

# Range codes are k_auto or an integer in the range 1 to n_range specific to a given function. #
INT k_auto = -1;

# Function codes are 1 to ELEMS dmkinfo  #
INT k_dcv  = 1;
INT k_acv  = 2;
INT k_dci  = 3;
INT k_aci  = 4;
INT k_res  = 5;
INT k_fres = 6;
INT k_freq = 7;
INT k_per  = 8;
INT k_cont = 9;
INT k_diod = 10;
INT k_cap  = 11;
INT k_nf = k_cap;

# Function names and variants, base command string, valid range count, range string array, resolution string array. #
[k_nf]FUNCDESC dmkinfo := (
   (("DCV","",""), ":MEAS:VOLT:DC",   5, ("200mv","2V","20V","200V","1000V","",""), ("100nV","1uV","10uV","100uV","1mV","","")),
   (("ACV","",""), ":MEAS:VOLT:AC",   5, ("200mv","2V","20V","200V","750V","",""), ("100nV","1uV","10uV","100uV","1mV","","")),
   (("DCI","",""), ":MEAS:CURR:DC",   6, ("200uA","2mA","20mA","200mA","2A","10A",""), ("1nA","10nA","100nA","1uA","10uA","100uA","")),
   (("ACI","",""), ":MEAS:CURR:AC",   4, ("20mA","200mA","2A","10A","","",""), ("100nA","1uA","10uA","100uA","","","")),
   (("OHM","RES","2WR"), ":MEAS:RES",    7, ("200","2k","20k","200k","1M","10M","100M"), ("1u","10u","100u","1m","10m","100m","1")),
   (("OHM4","FRES","4WR"), ":MEAS:FRES", 7, ("200","2k","20k","200k","1M","10M","100M"), ("1u","10u","100u","1m","10m","100m","1")),
   (("FREQ","",""), ":MEAS:FREQ",     5, ("200mv","2V","20V","200V","750V","",""), ("100nV","1uV","10uV","100uV","1mV","","")),
   (("PER","",""), ":MEAS:PER",       5, ("200mv","2V","20V","200V","750V","",""), ("100nV","1uV","10uV","100uV","1mV","","")),
   (("CONT","",""), ":MEAS:CONT",     0, ("","","","","","",""), ("","","","","","","")),
   (("DIOD","",""), ":MEAS:DIOD",     0, ("","","","","","",""), ("","","","","","","")),
   (("CAP","",""), ":MEAS:CAP",       6, ("2n","20n","200n","2u","200u","10m",""), ("1f","10f","100f","1p","100p","1u",""))
);

# Current state of the device. Range must be tracked independently for each function. #
MODE DMKKK = STRUCT( PIPE device, BOOL ok, INT i_func, [k_nf]INT i_range );

# ===================== #
# Device open and close #
# ===================== #

# Open a connection to a DM3K multi-meter. The vendorID and productId are internally fixed. #
# The device MUST be attached, and r/w permissions via UDEV rules MUST have been set for it #
# before calling this routine. Optionally, reset the device. #
PROC open_dm3k = (BOOL reset) REF DMKKK:
(
   REF DMKKK dev3k = HEAP DMKKK;
   PIPE p;
   STRING vid_rigol = "0x1ab1";  # Fixed for all Rigol devices. #
   STRING pid_dm3k = "0x09c4";   # DM3000 series multimeter. #
   BOOL ok := open_usbtmc(vid_rigol, pid_dm3k, p);

   # Start off in DCV with auto-ranging on all functions. Should be correct after a reset. #
   dev3k := (p, ok, k_dcv, (k_auto,k_auto,k_auto,k_auto,k_auto,k_auto,k_auto,k_auto,k_auto,k_auto,k_auto));
   (NOT ok OF dev3k | done);

   # See if this (dev_no) looks like a Rigol DM3000. #
   STRING inquiry;
   VOID(query_usbtmc(p, "*IDN?", inquiry));
   IF NOT (string in string("Rigol", NIL, inquiry) AND string in string("DM3", NIL, inquiry))
   THEN
      put(stand error, ("Inquiry string did not contain items expected for a Rigol DM3000 device. \
Open failed.", new line));
      put(stand error, ("[",inquiry,"]",new line));
      VOID(close_usbtmc(p));
      done
   FI;

   # Reset? If not, the instrument would have to be queried for current function and range. #
   # Probably the ranges of all functions ... but there seems to be no way to know if auto  #
   # or manual ranging is being used, so there is an issue here. Try switching to manual #
   # ranging in that case. This may work for the current function, at least.  #
   IF reset 
   THEN
      ie(put_usbtmc(p, "*RST"));
      sleep_void(5)

   ELSE
      # Get the current function from the device. #
      (NOT get_function_dm3k(dev3k) | 
            VOID(close_usbtmc(device OF dev3k)); ok OF dev3k := FALSE; done);

      # Set manual ranging mode and get the range for the current function. #
      (NOT set_manual_range_dm3k(dev3k) |
            VOID(close_usbtmc(device OF dev3k)); ok OF dev3k := FALSE; done)
   FI;

   done:
   dev3k
);

# Check if the device was opened correctly. #
OP DEV_INVALID = (REF DMKKK dev3k) BOOL:
(
   NOT (ok OF dev3k)
);

# Close the device. #
PROC close_dm3k = (REF DMKKK dev3k) VOID:
(
   (NOT DEV_INVALID dev3k | VOID(close_usbtmc(device OF dev3k)))
);

# ==================== #
# Function get and set #
# ==================== #

# Identify func as an acceptable function name and return the function code for that. #
PROC func_to_i_func = (STRING func) INT:
(
   INT retval := -1;

   FOR i TO k_nf
   DO
      FOR j TO k_nn
      DO
         (begins_with(func, (names OF dmkinfo[i])[j]) | retval := i; done)
      OD
   OD;

   done:
   retval
);

# Output informative message when the function code is invalid. #
PROC invalid_i_func = (REF DMKKK dev3k, STRING caller) VOID:
(
   put(stand error, ("Invalid i_func found in ", caller, new line))
);

# Get the current function from the device and set i_func in dev3k appropriately. #
# The device should return one of the following strings: #
# DCV, ACV, DCI, ACI, RESISTANCE, CAPACITANCE, CONTINUITY, FRESISTANCE, #
# DIODE, FREQUENCY, PERIOD, but there appear to be some variations with resistance. #
# Return TRUE if OK, else FALSE. #
PROC get_function_dm3k = (REF DMKKK dev3k) BOOL:
(
   BOOL retval := FALSE;
   (DEV_INVALID dev3k | done);
   STRING response;
   INT i_func;
   PIPE dev := device OF dev3k;

   # Get the current function from the device. #
   INT status := query_usbtmc(dev, ":FUNC?", response);

   # If all is well, set our record of the current function. #
   (status = 0 | i_func := func_to_i_func(response); # Convert function string to code. #
                 (i_func < 0 | # Invalid function code. #
                       invalid_i_func(dev3k, "get_function"); done | 
                          retval := TRUE; i_func OF dev3k := i_func)); # Valid function code.  #
   done:
   retval
);

# Set what we what to measure. #
PROC set_function_dm3k = (REF DMKKK dev3k, STRING function) BOOL:
(
   BOOL retval := FALSE;
   (DEV_INVALID dev3k | done);
   PIPE dev := device OF dev3k;
   STRING despaced_upper_function := despace(string_to_upper(function));

   # Identify the requested function. #
   INT new_i_func := func_to_i_func(despaced_upper_function);
   (new_i_func < 0 | put(stand error, ("Unknown function requested: ", function, new line)); done);

   # Convert the MEAS command for the new function to a FUNC command.  #
   STRING cmd := cmd OF dmkinfo[new_i_func];
   cmd[2:5] := "FUNC";

   # Set the new function in the instrument. #
   INT status := put_usbtmc(dev, cmd);
   (status /= 0 | put(stand error, ("Failed to set function.", new line)); done);
   i_func OF dev3k := new_i_func;

   # Get the range for the function from the device then record it UNLESS there is auto ranging set on that function.  #
   INT queried_code;
   (NOT get_range_dm3k(dev3k, FALSE, queried_code) | done); 
   
   # It all worked. #
   retval := TRUE;

   done:
   retval
);

# ================= #
# Range get and set #
# ================= #

# Get the range for the current function from the device and set i_range[i_func] in devk  #
# to the value obtained. Only do this if i_func is NOT currently auto ranging unless override_auto. #
# Return the range code reported by the device in queried_code. #
# Return TRUE if OK, else FALSE. #
PROC get_range_dm3k = (REF DMKKK dev3k, BOOL override_auto, REF INT queried_code) BOOL:
(
   BOOL retval := FALSE; # Set all output values before we can return. #
   queried_code := 0;
   (DEV_INVALID dev3k | done);
   STRING response;
   INT i_func;
   PIPE dev := device OF dev3k;

   # Check current function is valid. #
   ( (i_func OF dev3k) < 1 OR (i_func OF dev3k) > k_nf | invalid_i_func(dev3k, "get_range"); done);

   # The DIOD and CONT functions have no associated (useful) ranges. Return code 1 and TRUE for them. #
   ( (i_func OF dev3k) = k_diod OR (i_func OF dev3k) = k_cont | queried_code := 1; retval := TRUE; done);

   # Get the range code for the current function from the device. #
   INT status := query_usbtmc(dev, cmd OF dmkinfo[i_func OF dev3k]+":RANG?", response);
   IF status = 0
   THEN
      # Set the queried code. Conditionally update our record of the range code for the current function. #
      queried_code := string_to_int(response) + 1;
      (((i_range OF dev3k)[i_func OF dev3k] /= k_auto) OR override_auto | (i_range OF dev3k)[i_func OF dev3k] := queried_code);
      retval := TRUE
   FI;

   done:
   retval
);

# Given a range code for the current function, convert it to a range string relevant to that function. #
PROC range_code_to_range_string = (REF DMKKK dev3k, INT range_code) STRING:
(
   range_code_to_range_string_func(dev3k, i_func OF dev3k, range_code)
);

# Given a range code for a specified function, convert it to a range string relevant to that function. #
PROC range_code_to_range_string_func = (REF DMKKK dev3k, INT i_func, INT range_code) STRING:
(
   STRING retval := "-----";
   (DEV_INVALID dev3k | done);

   # Check current function is valid. And the supplied range code wrt that function. #
   ( i_func < 1 OR i_func > k_nf | invalid_i_func(dev3k, "range_code_to_range_string"); done);
   ( range_code /= k_auto AND (range_code < 1 OR range_code > n_range OF dmkinfo[i_func]) | done);
   
   # Look up the range string. Or output "Auto" if in k_auto. #
   retval := (range_code = k_auto | "Auto" | (rangenames OF dmkinfo[i_func])[range_code]);

   done:
   retval
);

# Given a range code for the current function, convert it to a resolution string relevant to that function. #
PROC range_code_to_resolution_string = (REF DMKKK dev3k, INT range_code) STRING:
(
   range_code_to_resolution_string_func(dev3k, i_func OF dev3k, range_code)
);

# Given a range code for the current function, convert it to a resolution string relevant to that function. #
PROC range_code_to_resolution_string_func = (REF DMKKK dev3k, INT i_func, INT range_code) STRING:
(
   STRING retval := "-----";
   (DEV_INVALID dev3k | done);

   # Check current function is valid. And the supplied range code wrt that function. #
   ( i_func < 1 OR i_func > k_nf | invalid_i_func(dev3k, "range_code_to_range_string"); done);
   ( range_code < 1 OR range_code > n_range OF dmkinfo[i_func] | done);
   
   # Look up the range string. #
   retval := (resolutions OF dmkinfo[i_func])[range_code];

   done:
   retval
);

# Get the range code of the currently selected function. #
PROC get_range_code_of_current_function = (REF DMKKK dev3k) INT:
(
   (i_range OF dev3k)[i_func OF dev3k]
);

# Get the range string of the currently selected function. #
PROC get_range_string_of_current_function = (REF DMKKK dev3k) STRING:
(
   range_code_to_range_string(dev3k, get_range_code_of_current_function(dev3k))
);


# Set manual ranging for the current function and get the range for that function. #
PROC set_manual_range_dm3k = (REF DMKKK dev3k) BOOL:
(
   BOOL retval := FALSE;
   (DEV_INVALID dev3k | done);
   PIPE dev := device OF dev3k;

   # Tell the device to enter manual ranging mode for the current function. #
   INT status := put_usbtmc(dev, ":MEAS MANU"); 
   (status /= 0 |  put(stand error, ("Failed to set range mode to MANUAL.", new line)); done);

   # Get the range code from the device and set our record of this, possibly replacing k_auto  #
   INT queried_range;
   retval := get_range_dm3k(dev3k, TRUE, queried_range);

   done:
   retval
);

# Set auto-ranging mode for the current function. #
PROC set_auto_range_dm3k = (REF DMKKK dev3k) BOOL:
(
   BOOL retval := FALSE;
   (DEV_INVALID dev3k | done);
   PIPE dev := device OF dev3k;

   # Check current function is valid. #
   ( (i_func OF dev3k) < 1 OR (i_func OF dev3k) > k_nf | invalid_i_func(dev3k, "set_auto_range"); done);

   # Tell the device to enter auto ranging mode for the current function. #
   INT status := put_usbtmc(dev, ":MEAS AUTO"); 
   (status = 0 | retval := TRUE | put(stand error, ("Failed to set range mode to AUTO.", new line)); done);

   # Set our record of the raange for this function to k_auto. #
   (i_range OF dev3k)[i_func OF dev3k] := k_auto;

   done:
   retval
);

# Set the range for the current function to a specified range code (function dependent). #
PROC set_range_dm3k = (REF DMKKK dev3k, INT range) BOOL:
(
   BOOL retval := FALSE;
   (DEV_INVALID dev3k | done);
   PIPE dev := device OF dev3k;

   # If range is k_auto, let  set_auto_range_dm3k() do the work. #
   (range = k_auto | retval := set_auto_range_dm3k(dev3k); done);

   # Check current function is valid. #
   ( (i_func OF dev3k) < 1 OR (i_func OF dev3k) > k_nf | invalid_i_func(dev3k, "set_range"); done);

   # Find the valid range codes for the current function. CONT and DIOD functions have no ranges. #
   INT max_range := n_range OF dmkinfo[i_func OF dev3k];
   (max_range = 0 | retval := TRUE; done);
   
   # Check range code is valid. #
   (range < 1 OR range > max_range | 
         put(stand error, ("Range code: ", range, " is invalid for current function.", new line)); 
         done);

   # Set range mode to MANUAL. #
   (NOT set_manual_range_dm3k(dev3k) |
         put(stand error, ("Failed to set range mode to MANUAL.", new line)); done);

   # Set the desired range. #
   STRING cmd := cmd OF dmkinfo[i_func OF dev3k];
   INT status := put_usbtmc(dev, cmd+" "+wint(range-1));

   # Update the range code for the function. #
   (status = 0 | (i_range OF dev3k)[i_func OF dev3k] := range; retval := TRUE
      | put(stand error, ("Failed to set range.", new line)));
   
   done:
   retval
);

# Increment (inc=TRUE) or decrement the range code and set that range. Clamp at valid code limits. #
PROC inc_dec_range_dm3k = (REF DMKKK dev3k, BOOL inc) BOOL:
(
   BOOL retval := FALSE;
   (DEV_INVALID dev3k | done);

   # Check current function is valid. #
   ( (i_func OF dev3k) < 1 OR (i_func OF dev3k) > k_nf | invalid_i_func(dev3k, "inc_dec_range"); done);

   # Only do anything if in manual range mode on the current function. #
   ((i_range OF dev3k)[i_func OF dev3k] = k_auto | retval := TRUE; done);

   # Find the valid range codes for the current function. CONT and DIOD functions have no ranges. #
   INT max_range := n_range OF dmkinfo[i_func OF dev3k];
   (max_range = 0 | retval := TRUE; done);

   # Get the next higher or lower valid range code for the function and set it in the device.  #
   INT next_range := clamp_int( (i_range OF dev3k)[i_func OF dev3k] + (inc | 1 | -1), 1, max_range);
   retval := set_range_dm3k(dev3k, next_range);

   done:
   retval
);

# Set the range for the current function to one suitable for measuring up to value. #
PROC set_range_by_maximum_value_dm3k = (REF DMKKK dev3k, REAL value) BOOL:
(
   BOOL retval := FALSE;
   (DEV_INVALID dev3k | done);

   # Check current function is valid. #
   ( (i_func OF dev3k) < 1 OR (i_func OF dev3k) > k_nf | invalid_i_func(dev3k, "set_range_by_maximum_value"); done);

   # Find the valid range codes for the current function. CONT and DIOD functions have no ranges. #
   INT max_range := n_range OF dmkinfo[i_func OF dev3k];
   (max_range = 0 | retval := TRUE; done);

   # Convert range strings for i_func to real numbers in range_maximum. #
   STRING units;
   REAL range_maximum;
   INT range_code := -1;
   FOR i TO max_range
   DO
      STRING range_string := (rangenames OF dmkinfo[i_func OF dev3k])[i];
      (NOT si_string_to_real(range_string, range_maximum, units) | 
            put(stand error, ("Failed to convert range string to real.", new line)); done);

      # If value is less than range_maximum, this is a suitable range. #
      ( value < range_maximum | range_code := i; break )
   OD;

   # Was it found? If value is too big, use max_range anyway. #
   break:
   ( range_code < 0 | range_code := max_range );

   # Set range by range code. #
   retval := set_range_dm3k(dev3k, range_code);

   done:
   retval
);

# ======= #
# Measure #
# ======= #

# Make a measurement of the quantity defined by the current function. #
PROC measure_dm3k = (REF DMKKK dev3k, REF REAL value, REF BOOL overload) BOOL:
(
   BOOL retval := FALSE;
   value := 0.0;
   overload := FALSE;
   (DEV_INVALID dev3k | done);
   PIPE dev := device OF dev3k;

   # Check current function is valid. #
   ( (i_func OF dev3k) < 1 OR (i_func OF dev3k) > k_nf | invalid_i_func(dev3k, "measure"); done);

   # The DIOD and CONT functions have no associated (useful) measurements. Return 0 and TRUE for them. #
   ( (i_func OF dev3k) = k_diod OR (i_func OF dev3k) = k_cont | value := 0.0; retval := TRUE; done);

   # Form the measurement command and get a string value measurement. #
   STRING cmd := cmd OF dmkinfo[i_func OF dev3k] + "?";
   STRING stvalue := "-1";
   INT status := query_usbtmc(dev, cmd, stvalue);

   # Convert the string measurement to a real number. Test for OVERLOAD. #
   (status = 1 | done);  # All real errors. #
   (status = 2 | overload := TRUE; retval := TRUE; done); # Treat timeouts as overload, but not fatal. #
   (NOT string_to_real(stvalue, value, FALSE) | done ); 
   overload := (ABS(value) > 8E15); # Overload seems to be signalled by 9E15. #
   retval := TRUE;
   
   done:
   retval
);


# ------ #
# TESTS. #
# ------ #

IF FALSE
THEN
REF DMKKK dev := open_dm3k(TRUE);
(DEV_INVALID dev | put(stand error, ("Open failed.", new line)); stop);

REAL value := 0.0;
BOOL overload;

print(("DC voltage measurement quick test (x3)",newline));
print(("---------------------------------------",newline));
FOR i TO 3 
DO
(measure_dm3k(dev, value, overload) | print(("[",value,"] over:",overload,new line)) | print(("Failed.", new line)); stop)
OD;

print((newline,"All functions quick test.",newline));
print((        "-------------------------",newline));
FOR i TO k_nf
DO
   STRING func_name := (names OF dmkinfo)[i][1];
   IF i /= k_cap # Capacitance measurements seem to time out if no capacitor, and unplugging and/or power cycling is then needed! #
   THEN
      (NOT set_function_dm3k(dev, func_name) | put(stand error, ("Sel ", func_name, " func failed.",newline)); stop);
      (measure_dm3k(dev, value, overload) | print(("... [",value,"] over:",overload,new line)) | print(("Failed ms.", new line)); stop);
      INT queried_code;
      (get_range_dm3k(dev, FALSE, queried_code) | 
            print(("... device range = ",wint(queried_code),new line)) | print(("Failed gr.", new line)); stop);
      print(("... Instrument range string = ", range_code_to_range_string(dev, queried_code), new line));
      print(("... Resolution string = ", range_code_to_resolution_string(dev, queried_code), new line))
   FI
OD;

print((newline,"Range switching test.",newline));
print((        "---------------------",newline));

# Set manual ranges on DCV and OHM. #
(NOT set_function_dm3k(dev, "DCV") | put(stand error, ("Sel DCV func failed.",newline)); stop);
(NOT set_range_dm3k(dev, 5) | put(stand error, ("Set DCV range failed.",newline)); stop | print(("Set DCV to range 5",newline)));

(NOT set_function_dm3k(dev, "OHM") | put(stand error, ("Sel OHM func failed.",newline)); stop);
(NOT set_range_dm3k(dev, 5) | put(stand error, ("Set OHM range failed.",newline)); stop | print(("Set OHM to range 5",newline)));

# Display our record of the ranges set.  #
print((newline,"Recorded ranges after setting range 5 on DCV and OHM.",newline));
FOR i TO k_nf
DO
   STRING func_name := (names OF dmkinfo)[i][1];
   STRING range_name := range_code_to_range_string_func(dev, i, (i_range OF dev)[i]);
   print(("Function: ", func_name, " Range:", range_name, new line))
OD;

# Do some measurements. #
print((newline,"Measure DCV, ACV and OHM.",newline));
(NOT set_function_dm3k(dev, "DCV") | put(stand error, ("Sel DCV func failed.",newline)); stop);
(measure_dm3k(dev, value, overload) | print(("... DCV [",value,"] over:",overload,new line)) | print(("Failed ms.", new line)); stop);
(NOT set_function_dm3k(dev, "ACV") | put(stand error, ("Sel ACV func failed.",newline)); stop);
(measure_dm3k(dev, value, overload) | print(("... ACV [",value,"] over:",overload,new line)) | print(("Failed ms.", new line)); stop);
(NOT set_function_dm3k(dev, "OHM") | put(stand error, ("Sel OHM func failed.",newline)); stop);
(measure_dm3k(dev, value, overload) | print(("... OHM [",value,"] over:",overload,new line)) | print(("Failed ms.", new line)); stop);

# ----- #

# Set auto ranges on DCV and OHM again. #
(NOT set_function_dm3k(dev, "DCV") | put(stand error, ("Sel DCV func failed.",newline)); stop);
(NOT set_range_dm3k(dev, k_auto) | put(stand error, ("Set DCV range failed.",newline)); stop | print(("Set DCV to auto range",newline)));

(NOT set_function_dm3k(dev, "OHM") | put(stand error, ("Sel OHM func failed.",newline)); stop);
(NOT set_range_dm3k(dev, k_auto) | put(stand error, ("Set OHM range failed.",newline)); stop | print(("Set OHM to auto range",newline)));

# Set ACV to range 5. #
(NOT set_function_dm3k(dev, "ACV") | put(stand error, ("Sel ACV func failed.",newline)); stop);
(NOT set_range_dm3k(dev, 5) | put(stand error, ("Set ACV range failed.",newline)); stop | print(("Set ACV to range 5",newline)));

# Display our record of the ranges set, again. #
print((newline,"Recorded ranges after setting range 5 on ACV, auto on DCV and OHM.",newline));
FOR i TO k_nf
DO
   STRING func_name := (names OF dmkinfo)[i][1];
   STRING range_name := range_code_to_range_string_func(dev, i, (i_range OF dev)[i]);
   print(("Function: ", func_name, " Range:", range_name, new line))
OD;

# Do some measurements, again. #
print((newline,"Measure DCV, ACV and OHM.",newline));
(NOT set_function_dm3k(dev, "DCV") | put(stand error, ("Sel DCV func failed.",newline)); stop);
(measure_dm3k(dev, value, overload) | print(("... DCV [",value,"] over:",overload,new line)) | print(("Failed ms.", new line)); stop);
(NOT set_function_dm3k(dev, "ACV") | put(stand error, ("Sel ACV func failed.",newline)); stop);
(measure_dm3k(dev, value, overload) | print(("... ACV [",value,"] over:",overload,new line)) | print(("Failed ms.", new line)); stop);
(NOT set_function_dm3k(dev, "OHM") | put(stand error, ("Sel OHM func failed.",newline)); stop);
(measure_dm3k(dev, value, overload) | print(("... OHM [",value,"] over:",overload,new line)) | print(("Failed ms.", new line)); stop);

# ----- #

# Set manual range by value on DCV. #
(NOT set_function_dm3k(dev, "DCV") | put(stand error, ("Sel DCV func failed.",newline)); stop);
(NOT set_range_by_maximum_value_dm3k(dev, 150.0) | put(stand error, ("Set DCV range by value failed.",newline)); stop | 
      print(("Set DCV to range for 150V",newline)));

# Display our record of the ranges set, again. #
print((newline,"Recorded ranges after setting 150V range on DCV.",newline));
FOR i TO k_nf
DO
   STRING func_name := (names OF dmkinfo)[i][1];
   STRING range_name := range_code_to_range_string_func(dev, i, (i_range OF dev)[i]);
   print(("Function: ", func_name, " Range:", range_name, new line))
OD;

# Do some measurements, again. #
print((newline,"Measure DCV.",newline));
(NOT set_function_dm3k(dev, "DCV") | put(stand error, ("Sel DCV func failed.",newline)); stop);
(measure_dm3k(dev, value, overload) | print(("... DCV [",value,"] over:",overload,new line)) | print(("Failed ms.", new line)); stop);

# ----- #

# Increment DCV once. #
print((newline,"Increment DCV range.",newline));
(NOT inc_dec_range_dm3k(dev, TRUE) | put(stand error, ("Inc DCV func failed.",newline)); stop);
STRING range_name := range_code_to_range_string_func(dev, k_dcv, (i_range OF dev)[k_dcv]);
print(("Recorded range on DCV now: ",range_name,newline));

# Decrement DCV twice. #
print((newline,"Decrement DCV range twice.",newline));
(NOT inc_dec_range_dm3k(dev, FALSE) | put(stand error, ("Dec DCV func failed.",newline)); stop);
(NOT inc_dec_range_dm3k(dev, FALSE) | put(stand error, ("Dec DCV func failed.",newline)); stop);
range_name := range_code_to_range_string_func(dev, k_dcv, (i_range OF dev)[k_dcv]);
print(("Recorded range on DCV now: ",range_name,newline));

done:
close_dm3k(dev)
FI;
