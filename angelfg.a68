COMMENT
Routines for controlling an ANGEL X3325X DDS function generator over serial.
============================================================================

Allow all features of this homemade function generator to be controlled programmatically.
Since the device has no physical control panel, this is really the only way to use it!

When the device is opened, it initialises, after which it sends a single * character.
Commands are short strings (1 character, in fact) followed by a numeric argument terminated by
a . or a string argument terminated by ]. Each command gets a 1 character response: * if OK
or ? if the command was not understood.

Author: Nick Glazzard 2026
--------------------------
COMMENT

PR read "serialio.a68" PR

MODE AFG = STRUCT( PIPE p, BOOL fake, BOOL ok, FLEX [1:0] REAL caldata );

# Open a serial connection to the function generator. This will be on /dev/ttyACM<dev_no>. #
# For debug and demo purposes, this can operate *without* an AFG attached if fake is TRUE. #
PROC open_afg = (INT dev_no, BOOL fake) REF AFG:
(
   REF AFG afg = HEAP AFG;
   STRING dev_name := "/dev/ttyACM" + wint(dev_no);
   fake OF afg := fake;
   IF fake OF afg
   THEN
      ok OF afg := TRUE
   ELSE
      ok OF afg := open_serial(dev_name, "9600,8,N,1", p OF afg);
      (NOT ok OF afg | done);

      # Get the * character sent after initialisation. #
      CHAR response := read_serial_char(p OF afg);
      (response /= "*" | 
            put(stand error, ("open_afg() failed.", new line));
            close_serial(p OF afg);
            ok OF afg := FALSE
      )
   FI;

   # Read calibration file. If it doesn't exist, caldata will be empty. #
   caldata OF afg := read_1d_real_array("afg_calibration.dat");
   (ARRAYEMPTY (caldata OF afg) | 
         put(stand error, ("Warning: failed to read afg_calibration.dat", new line)));

   done:
   afg
);

# Check if the device was opened correctly. #
OP AFG_INVALID = (REF AFG afg) BOOL:
(
   NOT (ok OF afg)
);

# Close the connection to the AFG. #
PROC close_afg = (REF AFG afg) VOID:
(
   ((NOT AFG_INVALID afg) AND (NOT fake OF afg) |
      close_serial(p OF afg);
      ok OF afg := FALSE
   )
);

# Send a command and check for the expected response. #
PROC send_cmd_afg = (REF AFG afg, STRING cmd) BOOL:
(
   BOOL retval := FALSE;

   IF NOT AFG_INVALID afg
   THEN
      CO print(("cmd=[",cmd,"]",newline)); CO
      IF NOT fake OF afg
      THEN
         write_serial_line(p OF afg, cmd);
         CHAR response := read_serial_char(p OF afg);
         (response /= "*" | put(stand error, ("Device response error: ", response, new line)); done);
         CO sleep_void(1); CO
         retval := TRUE
      FI
   FI;

   done:
   retval
);

# Set the waveform to sine, triangle or square. #
PROC set_waveform_afg = (REF AFG afg, STRING waveform) BOOL:
(
   BOOL retval := FALSE;
   STRING valid_waveforms = "sine,triangle,square";

   IF NOT AFG_INVALID afg
   THEN
      INT index := string_to_choice_index(string_to_lower(waveform), valid_waveforms);
      (index = 0 | put(stand error, ("Invalid waveform requested: ", waveform, new line)); done);
      retval := send_cmd_afg(afg, "w" + wint(index-1) + ".")
   FI;

   done:
   retval
);

# Set the frequency to output. #
PROC set_frequency_afg = (REF AFG afg, REAL frequency) BOOL:
(
   BOOL retval := FALSE;

   IF NOT AFG_INVALID afg
   THEN
      INT i_frequency := ROUND(10.0 * frequency);
      i_frequency := clamp_int(i_frequency, 1, 10 000 000);
      retval := send_cmd_afg(afg, "f" + wint(i_frequency) + ".")
   FI;

   retval
);

# Set the range to output. 0=0:5V. 1=0:500mV, 2=0:50mV #
PROC set_range_afg = (REF AFG afg, INT range) BOOL:
(
   BOOL retval := FALSE;

   IF NOT AFG_INVALID afg
   THEN
      INT i_range := clamp_int(range, 0, 2);
      retval := send_cmd_afg(afg, "r" + wint(i_range) + ".")
   FI;

   retval
);

# Set the output attenuation. 0=min output. 255=max output. #
PROC set_atten_afg = (REF AFG afg, INT atten) BOOL:
(
   BOOL retval := FALSE;

   IF NOT AFG_INVALID afg
   THEN
      INT i_atten := clamp_int(atten, 0, 255);
      retval := send_cmd_afg(afg, "a" + wint(i_atten) + ".")
   FI;

   retval
);

# Set lower gain mode in output amplifier. This sort of doubles the available output levels. #
PROC set_lower_gain = (REF AFG afg, BOOL on) BOOL:
(
   BOOL retval := FALSE;

   IF NOT AFG_INVALID afg
   THEN
      INT i_on := (on | 1 | 0);
      retval := send_cmd_afg(afg, "d" + wint(i_on) + ".")
   FI;

   retval
);

# Set the output level to a specified RMS voltage. #
PROC set_rms_volts_afg = (REF AFG afg, REAL volts) BOOL:
(
   BOOL retval := FALSE;

   IF NOT AFG_INVALID afg
   THEN
      IF ARRAYEMPTY (caldata OF afg)
      THEN 
         put(stand error, ("Cannot set voltage: afg_calibration.dat read failed.", new line))
      ELSE
         INT index := ((caldata OF afg) ARRAYCLOSESTINDEX volts) - 1; # 0:1535 #
         INT range := index % 256; # 0:5 #
         INT atten := index - (range * 256); # 0:255 #
         INT low_gain := range % 3; # 0:1 #
         range -:= (3 * low_gain); # 0:2 #
         (NOT set_lower_gain(afg, low_gain = 1) | done);
         (NOT set_range_afg(afg, range) | done);
         (NOT set_atten_afg(afg, atten) | done);
         retval := TRUE
      FI
   FI;

   done:
   retval
);

# Set the output level to a specified p-p voltage. #
PROC set_pp_volts_afg = (REF AFG afg, REAL volts) BOOL:
(
   REAL rms_volts := volts / (2.0 * sqrt(2.0));
   set_rms_volts_afg(afg, rms_volts)
);

# Set the output level according to one of definitions. #
PROC set_volts_afg = (REF AFG afg, REAL volts, STRING variant) BOOL:
(
   BOOL retval := FALSE;
   STRING options := "p-p,rms,dbv,dbu";
   INT choice := string_to_choice_index(string_to_lower(variant), options);

   CASE choice
   IN
      # 1 p-p #  retval := set_pp_volts_afg(afg, volts),
      # 2 rms #  retval := set_rms_volts_afg(afg, volts),
      # 3 dBV #  (REAL rmsv := 10.0 ** (volts / 20.0); retval := set_rms_volts_afg(afg, rmsv)),
      # 4 dBu #  (REAL rmsv := 0.775 * (10.0 ** (volts / 20.0)); retval := set_rms_volts_afg(afg, rmsv))
   OUT
      put(stand error, ("set_volts_afg(): requested variant not known: ", variant, newline))
   ESAC;

   STRING volt_string := "Invalid voltage";
   (retval | format_volts_string(afg, volts, choice));

   done:
   retval
);

# Format the volts string for display on the LCD and send the string. #
PROC format_volts_string = (REF AFG afg, REAL volts, INT choice) VOID:
(
   STRING result;
   STRING supplement := (choice = 1 | " P-P" | " RMS");

   IF (choice = 1) OR (choice = 2)
   THEN
      IF volts >= 1.0
      THEN
         putsf(result, ($%4.2f%s%s$, volts, "V", supplement))
      ELIF volts >= 0.001
      THEN
         putsf(result, ($%4.1f%s%s$, 1 000.0*volts, "mV", supplement))
      ELSE
         putsf(result, ($%4d%s%s$, ROUND 1 000 000.0*volts, "uV", supplement))
      FI
   ELIF choice = 3
   THEN
      putsf(result, ($%4.1f%s$, volts, "dBV"))
   ELSE
      putsf(result, ($%4.1f%s$, volts, "dBu"))
   FI;

   VOID(send_cmd_afg(afg, "v" + result + "]"))
);

# ------ #
# TESTS. #
# ------ #

IF FALSE
THEN
REF AFG afg := open_afg(0, FALSE);
(AFG_INVALID afg | put(stand error, ("Giving up.", new line)); stop);

print((set_frequency_afg(afg, 7345.6)));
print((set_waveform_afg(afg, "square")));
print((set_range_afg(afg, 0)));
print((set_atten_afg(afg, 51)));

close_afg(afg)
FI;
