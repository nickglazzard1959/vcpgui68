PROC stortst = (STRING s) VOID:
(
   REAL vt;
   put(stand error, ("v ", s, ": ", string_to_real(s, vt, TRUE)));
   put(stand error, (" result = ", vt, newline))
);

PROC stortst_f = (STRING s) VOID:
(
   REAL vt;
   put(stand error, ("v ", s, ": ", string_to_real(s, vt, FALSE)));
   put(stand error, (" result = ", vt, newline))
);

PROC sistrtst = (STRING s) REAL:
(
   STRING units;
   REAL vt;
   put(stand error, ("v ", s, ": ", si_string_to_real(s, vt, units)));
   put(stand error, (" v = ", vt, " u = ", units, newline));
   vt
);

PROC rtosistst = (REAL v) VOID:
(
   STRING s;
   put(stand error, ("... v ", v, ": ", real_to_si_string(v, s, 8, 3, FALSE)));
   put(stand error, (" s = ", s, newline));
   put(stand error, ("... v ", v, ": ", real_to_si_string(v, s, 8, 3, TRUE)));
   put(stand error, (" s = ", s, newline, newline))
);

PROC rtosistst2 = (REAL v) VOID:
(
