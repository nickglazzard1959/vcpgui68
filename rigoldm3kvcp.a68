COMMENT
rigoldm3kvcp.a68 - Virtual control panel for a Rigol DM3000 series multi-meter.
===============================================================================

This controls and displays meaurements from a Rigol DM3000 multi-meter on Linux
using the USBTMC facilities available on that OS.

The program runs under Algol 68 Genie and displays a custom GUI using SDL2.

This software, including the GUI "library", utility code and test programs,
comes to less than 7,500 lines of Algol 68 and C++ ... including comments ...

Nick Glazzard 2026
------------------
COMMENT

PR heap=256M PR

PR read "utility.a68" PR
PR read "arg_parser.a68" PR
PR read "config_parser.a68" PR
PR read "vcpgui.a68" PR
PR read "rigol3kdmm.a68" PR

# Some state. #
STRING units := "V";
STRING function := "DC";
STRING rangestring := "Auto";
BOOL sample_auto := TRUE;

# Make a measurement. #
PROC read_measurement = VOID:
(
   REAL measurement;
   BOOL overload;

   IF measure_dm3k(device, measurement, overload)
   THEN
      INT i_measurement, dp := 0;
      STRING prefix;
      BOOL ok := real_to_si_real_scaled_dsurf(measurement, i_measurement, 8, prefix, dp, FALSE);
      CO put(stand error, ("ok=",ok," overload=",overload," measurement=",measurement," dp=",wint(dp),newline)); CO
      (overload | i_measurement := 99999999 | 
            (NOT ok | i_measurement := 0)); # CONT and DIOD will by NOT ok ...  #
      (dp = 8 | i_measurement %:= 10; dp -:=1); # Force a leading zero if all digits are decimal places. #
      set_numericdisplay(dsurf_pipe, "display", i_measurement, dp, NOT ok);
      set_numericdisplay_units(dsurf_pipe, "display", prefix + units);
      set_numericdisplay_function(dsurf_pipe, "display", function);
      set_numericdisplay_range(dsurf_pipe, "display", get_range_string_of_current_function(device));
      ds_show_display(dsurf_pipe)
   FI
);

# When the measure button is pressed, do this ... #
PROC measure_proc = (STRING tag, STRING event, ANYBUTTONREF state) BOOL:
(
   IF event[1] = "D"
   THEN
      CASE state
      IN
         (REF PUSHBUTTON pb): (
            read_measurement
         )
      OUT
         put(stand error, ("Expected a push button. Got something else!", new line))
      ESAC
   FI;
   FALSE
);

# When the timer goes off, do this ... #
PROC timer_proc = (STRING tag, STRING event, ANYBUTTONREF state) BOOL:
(
   CASE state
   IN
      (REF TIMER tm): (
         read_measurement;
         set_timer(dsurf_pipe, "timer", TRUE, FALSE) # Restart the timer. #
      )
   OUT
      put(stand error, ("Expected a timer. Got something else!", new line))
   ESAC;
   FALSE
);

# Change when to make a measurement. #
PROC sample_proc = (STRING tag, STRING event, ANYBUTTONREF state) BOOL:
(
   CASE state
   IN
      (REF RADIOBUTTON rb): (
         (get_radiobutton_sel_label(rb) = "AUTO" | sample_auto := TRUE;  set_timer(dsurf_pipe, "timer", TRUE, FALSE));
         (get_radiobutton_sel_label(rb) = "MANUAL" | sample_auto := FALSE; set_timer(dsurf_pipe, "timer", FALSE, FALSE))
      )
   OUT
      put(stand error, ("Expected a radio button. Got something else!", new line))
   ESAC;
   FALSE
);

# Make the range auto/manual buttons match a newly selected function's state. #
PROC update_auto = (REF DMKKK device) VOID:
(
   STRING which := ( get_range_code_of_current_function(device) = k_auto | "AUTO" | "MANUAL" );
   VOID(set_radiobutton_by_label(dsurf_pipe, "range", which, FALSE))
);

# Change what is being measured. #
PROC function_proc = (STRING tag, STRING event, ANYBUTTONREF state) BOOL:
(
   STRING ohm := REPR 222; # This gets converted to Unicode Omega (0x03a9) in DSURF. #
   []STRING all_functions = ("DC","AC","DC","AC","OHM","OHM4","FREQ","PER","CONT","DIODE","CAP");
   []STRING all_units = ("V","V","A","A",ohm,ohm,"Hz","s","","","F");
   []STRING all_funcnames = ("DCV","ACV","DCI","ACI","OHM","OHM4","FREQ","PER","CONT","DIOD","CAP");

   CASE state
   IN
      (REF RADIOBUTTON rb): (
         function := all_functions[which OF rb];
         units := all_units[which OF rb];
         ieb(set_function_dm3k(device, all_funcnames[which OF rb]));
         update_auto(device)
      )
   OUT
      put(stand error, ("Expected a radio button. Got something else!", new line))
   ESAC;
   FALSE
);

# Switch between automatic and manual range selection. #
PROC range_proc = (STRING tag, STRING event, ANYBUTTONREF state) BOOL:
(
   CASE state
   IN
      (REF RADIOBUTTON rb): (
         (get_radiobutton_sel_label(rb) = "AUTO" | ieb(set_auto_range_dm3k(device)));
         (get_radiobutton_sel_label(rb) = "MANUAL" | ieb(set_manual_range_dm3k(device)))
      )
   OUT
      put(stand error, ("Expected a radio button. Got something else!", new line))
   ESAC;
   FALSE  
);

# Increment the current range if in manual range mode. #
PROC inc_range_proc = (STRING tag, STRING event, ANYBUTTONREF state) BOOL:
(
   IF event[1] = "D"
   THEN
      CASE state
      IN
         (REF PUSHBUTTON pb): (
            ieb(inc_dec_range_dm3k(device, TRUE))
         )
      OUT
         put(stand error, ("Expected a push button. Got something else!", new line))
      ESAC
   FI;
   FALSE
);

# Decrement the current range if in manual range mode. #
PROC dec_range_proc = (STRING tag, STRING event, ANYBUTTONREF state) BOOL:
(
   IF event[1] = "D"
   THEN
      CASE state
      IN
         (REF PUSHBUTTON pb): (
            ieb(inc_dec_range_dm3k(device, FALSE))
         )
      OUT
         put(stand error, ("Expected a push button. Got something else!", new line))
      ESAC
   FI;
   FALSE
);


# ============ #
# MAIN PROGRAM #
# ============ #

print_std_title("Virtual control panel for a Rigol DM3000 series multi-meter. V0.1");

# Parse command line arguments. These MUST appear after --. #
REF ARG_PARSE arg_parser := make_arg_parser("Rigol DM3K Multimeter Virtual Control Panel");
REF INT device_number := arg_add_int_option(arg_parser, "-d", "--device",
                                                "Device number.",
                                                2);
REF BOOL reset_device := arg_add_flag(arg_parser, "-r", "--reset",
                                      "Reset the device on open.",
                                      FALSE);
( NOT parse_args(arg_parser) |
      put(stand error, ("Unknown or malformed command line arguments.", new line)); stop );

# Try to open the device before we do anything with the GUI. #
REF DMKKK device := open_dm3k(device_number, reset_device);
(DEV_INVALID device | print(("Failed to open multi-meter. Giving up.",newline)); stop);

# It looks like you must wait until the reset completes. There may be alternatives! #
(reset_device | pause("Please wait for device reset to complete"));

# Open and configure the GUI display surface. #
INT width := 600, height := 250;
PIPE dsurf_pipe := open_gui("Rigol DM3K Multimeter", width, height);

# Background ...  #
ds_set_colour_rgba(dsurf_pipe, 50, 50, 50, 255);
ds_clear(dsurf_pipe);

# Numeric display ...  #
ds_set_colour_rgba(dsurf_pipe, 180, 180, 180, 255);
add_numericdisplay("display", width%2, 65, 0, 8, 0, TRUE);

#  Function radiobutton ...  #
ds_set_colour_rgba(dsurf_pipe, 0, 0, 0, 255);
ds_set_font(dsurf_pipe, 0);
add_radiobutton("function", 
                "DCV,ACV,DCI,ACI,OHM,OHM4,FREQ,PERIOD,CONT,DIODE,CAP", 
                function_proc, width%2, 140, 1);

ds_set_colour_rgba(dsurf_pipe, 255, 255, 255, 255);
ds_text_in_font(dsurf_pipe, "FUNCTION", width%2, 165, TRUE, 0);

# Range radiobutton and oush buttons ...  #
ds_set_colour_rgba(dsurf_pipe, 0, 0, 0, 255);
add_radiobutton("range", 
                "AUTO,MANUAL", 
                range_proc, 75, 200, 1);
add_pushbutton("uprange", "UP", inc_range_proc, 150, 200);
add_pushbutton("downrange", "DOWN", dec_range_proc, 200, 200);
ds_set_colour_rgba(dsurf_pipe, 255, 255, 255, 255);
ds_text_in_font(dsurf_pipe, "RANGE", 125, 225, TRUE, 0);

# Sample radiobutton and push button ...  #
ds_set_colour_rgba(dsurf_pipe, 0, 0, 0, 255);
add_radiobutton("sample", 
                "AUTO,MANUAL", 
                sample_proc, 325, 200, 1);
add_pushbutton("measure", "MEAS", measure_proc, 400, 200);
ds_set_colour_rgba(dsurf_pipe, 255, 255, 255, 255);
ds_text_in_font(dsurf_pipe, "SAMPLE", 350, 225, TRUE, 0);

# Power off button ...  #
ds_set_colour_rgba(dsurf_pipe, 200, 0, 0, 255);
add_pushbutton("off", "OFF", quit_proc, width-50, 200);

# Automatic measurement timer ...  #
add_timer("timer", timer_proc, 2000);
sample_auto := TRUE;
set_timer(dsurf_pipe, "timer", TRUE, FALSE);

# Set initial device state. #
ieb(set_function_dm3k(device, "DCV"));

# Create and run the GUI. #
instantiate(dsurf_pipe);
CO pause("After instantiate"); CO
run_event_loop(dsurf_pipe);

# Shut down. #
end:
close_dsurf(dsurf_pipe)
