COMMENT
mindoc68.a68 - Very (very) minimal documentation extraction program for a68 code.
=================================================================================

This makes a *lot* of assumptions about how the code is formatted, but it is still
useful, at least for the VCPGUI project code.

It is *assumed* that:

1. The purpose of the file is described in a <long comment> to <long comment> block starting in line 1.
2. The purpose and how to use a PROC or OP is described by comment lines with *hashes*
   immediately *before* the PROC or OP definition. No blank line between the comment and the PROC/OP.
   No blank lines in the description comments.
3. Sections of related functions in the code begin with a single line hash comment followed
   and preceded by # --- # or # === # lines (spaces and number of -/= do not matter). These
   comments are used to create sub-sections in Markdown.

I toyed with automatic detection of items that should be treated as code and so on,
but it didn't work very well ... It is probably best to just use Markdown in comments
if desired. That should be safe. There are too many exceptions and oddities for simple
automatic schemes to work, it seems.

Author: Nick Glazzard 2026.
---------------------------
COMMENT

PR read "utility.a68" PR
PR read "dictionaries.a68" PR
PR read "arg_parser.a68" PR
PR read "config_parser.a68" PR

CHAR hash = REPR 35; # Hash - avoids Emacs A68 syntax highlighting going mad. #
CHAR dquote = REPR 34; # Double quote. #
STRING hash_string = STRING(hash);
STRING code_fence = 3 * "`"; 
STRING rule = 3 * "-";
INT line_break = 70;

# Globals to hold total of lines and lines of code statistics. #
INT global_lines := 0;
INT global_loc := 0;
INT global_procs := 0;
INT global_ops := 0;

# Format a formal declarations and return mode (procop) followed by #
# a description of that PROC or OP. #
PROC format_procop = (REF STRING_LIST comments, STRING procop, REF FILE fout, BOOL to_pdf) VOID:
(
   # Split procop into space separated words. #
   FLEX [1:0]STRING words := split_string(procop, " ");

   # Output the function definition. #
   IF NOT to_pdf
   THEN
      # Outputting HTML eventually. Do NOT split long lines in function defn. #
      put(fout, (new line, code_fence, new line,
                 procop, new line,
                 code_fence, new line))
   ELSE
      # Outputting PDF eventually. DO split long lines in function defn. #
      put(fout, (new line, code_fence, new line));
      INT line_length := 0;
      FOR i TO ELEMS words
      DO
         put(fout, (words[i]," "));
         line_length +:= ELEMS words[i] + 1;
         (line_length > line_break |
               put(fout, (newline)); 
               line_length := 0
         )
      OD;
      (line_length > 0 | put(fout, (newline)));
      put(fout, (new line, code_fence, new line))
   FI;

   # Output the comments describing the function. #
   REF STRING_LIST_ELEMENT list_line := FIRST comments;
   WHILE list_line ISNT nil_sle
   DO
      STRING output_line := trim( strip_char(value OF list_line, hash) );
      put(fout, (output_line, new line));
      list_line := NEXT comments
   OD;

   # End with a horizontal rule. #
   put(fout, (new line, rule, new line))
);

# Output a Markdown sub section heading. #
PROC format_sub_section = (STRING section, REF FILE fout) VOID:
(
   put(fout, (new line, hash, hash, " ", trim(strip_char(section, hash)), new line))
);

# Output a Markdown section heading. #
PROC format_section = (STRING section, REF FILE fout) VOID:
(
   put(fout, (new line, hash, " ", trim(strip_char(section, hash)), new line))
);

# Output a Markdown section heading in code typography. #
PROC format_section_code = (STRING section, REF FILE fout) VOID:
(
   put(fout, (new line, hash, " ", "`", trim(strip_char(section, hash)), "`", new line))
);

# Format introductory comments for the whole file. #
PROC format_intro = (REF STRING_LIST intro, REF FILE fout, BOOL to_pdf) VOID:
(
   BOOL in_code_block := FALSE;
   STRING spacer := 3*".";

   # Strip out strings that can be misinterpeted in Markdown. #
   REF STRING_LIST_ELEMENT list_line := FIRST intro;
   WHILE list_line ISNT nil_sle
   DO
      STRING output_line := trim(value OF list_line);
      BOOL ignore1 := (ELEMS output_line > 3 | (output_line[:3] = "---" | TRUE | FALSE) | FALSE);
      BOOL ignore2 := (ELEMS output_line > 3 | (output_line[:3] = "===" | TRUE | FALSE) | FALSE);
      BOOL ignore3 := (ELEMS output_line > 8 |
                            (string in string("Author:", NIL, output_line) | TRUE | FALSE) | FALSE);
      BOOL ignore := ignore1 OR ignore2 OR ignore3;
      IF NOT ignore
      THEN

         # Deal specially with URLs. #
         INT hypgo;
         BOOL has_link := string in string("http://", hypgo, output_line);
         (NOT has_link | has_link := string in string("https://", hypgo, output_line));
         IF has_link
         THEN
            put(fout, (output_line[:hypgo-1], new line));
            STRING urlbit := output_line[hypgo:];
            INT hypend;
            (NOT char in string(" ", hypend, urlbit) | hypend := ELEMS urlbit);
            put(fout, ("[", urlbit[:min2int(hypend,line_break)], "](", urlbit[:hypend], ")", new line))

         ELSE
            # Not a URL. Split long lines in code blocks only. But only for PDF output. #
            (begins_with(output_line, code_fence) | in_code_block := NOT in_code_block);
            IF in_code_block AND to_pdf
            THEN
               FLEX [1:0]STRING words := split_string(output_line, " ");
               INT line_length := 0;
               FOR i TO ELEMS words
               DO
                  put(fout, (words[i]," "));
                  line_length +:= ELEMS words[i] + 1;
                  (line_length > line_break |
                     put(fout, (newline, spacer)); 
                     line_length := 0
                  )
               OD;
               (line_length > 0 | put(fout, (newline)))
            ELSE
               put(fout, (output_line, new line))
            FI
         FI
      FI;

      list_line := NEXT intro
   OD;

   # End with a horizontal rule. #
   put(fout, (new line, rule, new line))
);

# Process a single source file. #
PROC process_source_file = (STRING source_file, REF FILE fout, BOOL to_pdf) VOID:
(
   # Open the source file. #
   FILE fin;
   INT status := open_file(source_file, "r", fin);
   ( status /= 0 |
         print_os_error("Cannot open source file", status); 
         stop);

   # Output a section header for the file. As a file name, should be in code font. #
   format_section_code(source_file, fout);

   # Read the file. Identify PROC and OP specifically. #
   # Also an initial COMMENT block as an introduction. #
   BOOL eof := FALSE;
   PROC at_eof = (REF FILE afin) BOOL: ( eof := TRUE );
   STRING input_line;
   on file end(fin, at_eof);

   # Keep accumulated PROC/OP description lines on a string list. #
   REF STRING_LIST accum := STRING_LIST_INIT LOC STRING_LIST;

   # Keep accumulated top comment material on a string list too. #
   REF STRING_LIST intro := STRING_LIST_INIT LOC STRING_LIST;  

   # Loop over all lines in the file. #
   BOOL last_empty := TRUE;
   BOOL last_comment := FALSE;
   BOOL multi_procop := FALSE;
   BOOL top_comment := FALSE;
   STRING multi_procop_def := "";
   INT line_no := 0;
   INT loc_no := 0;
   INT proc_no := 0;
   INT op_no := 0;
   DO
      get(fin, (input_line, new line)); (eof | file_end);
      line_no +:= 1;
      input_line := trim(input_line); # Remove leading and trailing white space. #
      BOOL empty := (ELEMS input_line = 0);
      (NOT empty AND line_no = 1 AND input_line = "COMMENT" | top_comment := TRUE);
      (NOT empty | (input_line[1] /= hash AND NOT top_comment | loc_no +:= 1));

      # First, deal with any top comment block. Use for introductory material. #
      IF top_comment
      THEN
         (line_no /= 1 AND input_line = "COMMENT" |
               format_intro(intro, fout, to_pdf);
               top_comment := FALSE |
                  (line_no /= 1 | intro +:= input_line)
         )

      # Next, deal with multi-line PROC or OP definition accumulation. #
      # Do nothing else until this is complete. #
      ELIF multi_procop
      THEN
         multi_procop_def +:= (" " + input_line);
         (ends_with(input_line, ":") |
               format_procop(accum, multi_procop_def, fout, to_pdf);
               VOID(CLEAR accum);
               multi_procop_def := "";
               multi_procop := FALSE)
      ELSE

         # Classify the line. #
         BOOL is_proc := begins_with(input_line, "PROC");
         BOOL is_op := begins_with(input_line, "OP");
         BOOL is_prio := begins_with(input_line, "PRIO");
         BOOL procop := is_proc OR is_op OR is_prio;
         BOOL comment := (empty | FALSE | input_line[1] = hash);

         # Transition from blank to comment. Start new accumulation. #
         IF last_empty AND comment
         THEN
            VOID(CLEAR accum);
            accum +:= input_line

         # Transition from comment to blank. Test for section, format. Discard accumulation. #
         ELIF last_comment AND empty
         THEN
            STRING last_comment_string := strip_blank( POP accum );
            BOOL section := begins_with(last_comment_string, "#---") OR 
                            begins_with(last_comment_string, "#===");
            (section |
                  STRING section_string := POP accum;
                  ((ELEMS accum > 0) AND (NOT string in string("TEST", NIL, section_string)) |
                        format_sub_section(section_string, fout))
            );
            VOID(CLEAR accum)

         # Transition from comment to PROC or OP. Format description. #
         # However, PROC and OP declarations may span multiple lines. #
         # This will be the case if the line doesn't end in a colon.  #
         ELIF last_comment AND procop
         THEN
            multi_procop := NOT ends_with(input_line, ":");
            (NOT multi_procop |
                  format_procop(accum, input_line, fout, to_pdf);
                  VOID(CLEAR accum) |
                     multi_procop_def := input_line
            );
            (is_proc | proc_no +:= 1);
            (is_op | op_no +:= 1)

         # Continuing a comment block after first line of description. #
         ELIF last_comment AND comment
         THEN
            accum +:= input_line
         FI;

         last_empty := empty;
         last_comment := comment
      FI # Not dealing with a multi-line PROC or OP definition. #
   OD;

   file_end:
   format_sub_section("Statistics", fout);
   put(fout, ("PROC declarations: ", wint(proc_no), "\", new line));
   put(fout, ("  OP declarations: ", wint(op_no), "\", new line));
   put(fout, ("      Total lines: ", wint(line_no), "\", new line));
   put(fout, ("    Lines of code: ", wint(loc_no), "\", new line));

   # Sum global statistics. #
   global_lines +:= line_no;
   global_loc +:= loc_no;
   global_procs +:= proc_no;
   global_ops +:= op_no;

   close(fin)
);

# ============ #
# MAIN PROGRAM #
# ============ #

print_std_title("Minimal Documentation Extraction Program V0.1");

# Define, get and parse command line arguments. These MUST appear after --. #
REF ARG_PARSE arg_parser := make_arg_parser("Minimal Documentation Extraction Program");
arg_set_description(arg_parser,
"This is a simple program that extracts descriptive comments for PROCs and OPs\n\
from Algol 68 programs in files with .a68 extensions. A set of input files for\n\
a project can be specified in a .ini configuration file, or a single file can\n\
be supplied. The output is always Markdown, with either HTML or PDF as an additional\n\
output. The latter formats require that Pandoc is installed, and also LaTeX for PDF.");
REF STRING doc_title := arg_add_string_option(arg_parser, "-t", "--title", "Document title", "");
REF STRING doc_author := arg_add_string_option(arg_parser, "-a", "--author", "Name of author", "Mindoc68");
REF STRING doc_width := arg_add_string_option(arg_parser, "-w", "--width", "HTML document width", "");
arg_add_positional_description(arg_parser, "Input .a68 file or .ini listing a set of .a68 files.");
arg_add_positional_description(arg_parser, "Output file with extension .md, .html or .pdf.");
( NOT parse_args(arg_parser) |
      put(stand error, ("Unknown or malformed command line arguments.", new line)); 
      stop );

INT npos := arg_get_n_positionals(arg_parser);
( npos /= 2 | 
      put(stand error, ("Expected source and output file name positional arguments.", new line)); 
      stop );

STRING source_file := arg_get_positional_n(arg_parser, 1);
STRING output_file := arg_get_positional_n(arg_parser, 2);
print(("Source file: ", source_file, new line));
print(("Output file: ", output_file, new line));

# Look at the extension on the output file to determine waht might be generated. #
# In all cases, Markdown in <output_file>.md will be output. If the output file  #
# has the extension .html or .pdf, those formats are generated from the Markdown #
# Pandoc (which must be installed for this, of course). #
STRINGPAIR output_stem_ext := splitext(output_file);
BOOL output_is_pdf := last OF output_stem_ext = ".pdf";

# If the source file has .ini extension, it should be a config file. Read it for file names. #
# The files to be processed should then be defined by a multi-line string with key 'files'. #
# Otherwise, we'll only process a single input file. #
FLEX [1:0]STRING source_files;
STRINGPAIR source_stem_ext := splitext(source_file);
IF last OF source_stem_ext = ".ini"
THEN
   REF CONFIG_PARSE cp := make_config_parser(source_file);
   IF NOT parse_config_file(cp)
   THEN
      put(stand error, ("Failed to parse config file [", source_file, "]. Giving up.", new line));
      stop
   ELSE
      STRING files := config_get_string_value(cp, "files", "");
      (files = "" | 
            put(stand error, ("Invalid config file (no files keyword), giving up.", new line)); 
            stop);
      REF STRING_LIST files_list := STRING_LIST_INIT LOC STRING_LIST;
      string_lines_to_string_list(files, files_list);
      source_files := string_list_as_array(files_list)
   FI
ELSE
   source_files := (source_file)
FI;

# Create the output file. Always Markdown at this point. #
FILE fout;
INT status := open_file(first OF output_stem_ext + ".md", "w", fout);
( status /= 0 |
      print_os_error("Cannot create output file", status); 
      stop);

# If there is a document title, output some YAML to make that appear. #
IF doc_title /= ""
THEN
   [8]INT ymdhms := local time;
   put(fout, ("---", new line));
   put(fout, ("title: ", dquote, doc_title, dquote, new line));
   put(fout, ("author: ", dquote, doc_author, dquote, new line));
   put(fout, ("date: ", dquote, wint(ymdhms[1]),"-",wint(ymdhms[2]),"-",wint(ymdhms[3]), dquote, newline));

   # If we are going to PDF (via LaTeX), try to fix section numbers overlapping their names. #
   # Warning: This YAML is *very* white space sensitive. #
   IF output_is_pdf
   THEN
      put(fout, ("header-includes:", new line));
      put(fout, (" - |", new line));
      put(fout, ("   \usepackage{a4wide}", new line));
      put(fout, ("   \usepackage{tocloft}", new line));
      put(fout, ("   \setlength{\cftsecnumwidth}{2.0em}", new line));
      put(fout, ("   \setlength{\cftsubsecnumwidth}{2.5em}", new line));
      put(fout, ("   \setlength{\cftsubsubsecnumwidth}{3.0em}", new line));
      put(fout, ("   \usepackage[scaled]{helvet}", new line));
      put(fout, ("   \renewcommand*\familydefault{\sfdefault}", new line))
   ELSE
      (doc_width /= "" | put(fout, ("maxwidth: ", doc_width, new line)))
   FI;
   put(fout, ("---", new line, new line))
FI;

# Process the source files. #
FOR i TO ELEMS source_files
DO
   print(("Reading: ", source_files[i], new line));
   STRINGPAIR this_source_stem_ext := splitext(source_files[i]);
   IF last OF this_source_stem_ext = ".a68"
   THEN
      process_source_file(source_files[i], fout, output_is_pdf)
   ELSE
      (NOT copy_file_contents(source_files[i], fout, FALSE) |
            put(stand error, ("... Failed to read: ", source_files[i], new line)))
   FI
OD;

# Write global statistics to the output file. #
put(fout, (new line, REPR 35, " Global Statistics", new line));
put(fout, (3 * "`", new line));
put(fout, ("  Global PROC declarations: ", wint(global_procs), new line));
put(fout, ("    Global OP declarations: ", wint(global_ops), new line));
put(fout, ("        Global total lines: ", wint(global_lines), new line));
put(fout, ("Global total lines of code: ", wint(global_loc), new line));
put(fout, (3 * "`", new line));

# Close the output file. #
close(fout);
put(stand out, ("Wrote: ", first OF output_stem_ext + ".md", new line));

# Optionally post-process the generated Markdown to other formats with Pandoc. #
BOOL post_process := output_is_pdf OR (last OF output_stem_ext = ".html");
IF post_process
THEN
   STRING cmd_output;
   STRING cmd := "pandoc -s --toc -N " + first OF output_stem_ext + ".md -o " + output_file +
   " --pdf-engine=/usr/bin/pdflatex";
   (run_command_get_output(cmd, cmd_output) |
         put(stand out, ("Wrote: ", output_file, new line)) |
            put(stand error, ("Failed to run Pandoc: ", cmd_output, new line)))
FI;

put(stand out, ("---------------------------------------------", new line));
put(stand out, ("  Global PROC declarations: ", wint(global_procs), new line));
put(stand out, ("    Global OP declarations: ", wint(global_ops), new line));
put(stand out, ("        Global total lines: ", wint(global_lines), new line));
put(stand out, ("Global total lines of code: ", wint(global_loc), new line));
put(stand out, ("---------------------------------------------", new line))
