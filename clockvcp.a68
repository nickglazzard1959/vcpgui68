COMMENT
clockvcp.a68 - A clock to demo some VCPGUI facilities.
======================================================

A pretty minimal example which runs without any weird hardware attached.
Also shows some features of the config_parser functions.

Author: Nick Glazzard 2026
--------------------------
COMMENT

PR heap=128M PR # Needs more than default heap size. Not sure why. #

PR read "utility.a68" PR
PR read "arg_parser.a68" PR
PR read "config_parser.a68" PR
PR read "vcpgui.a68" PR

# Some state. #
BOOL local := TRUE;
HMSTIME delta := make_hms(0, 0, 0, 0);

# Handle timer events. #
PROC tick_proc = (STRING tag, STRING event, ANYBUTTONREF state) BOOL:
(
   CASE state
   IN
      (REF TIMER tm): (
         HMSTIME now := get_time_of_day(NOT local);
         HMSTIME adjusted := now + delta;
         set_timedisplay_hms(gui, "display", adjusted);
         set_timer(gui, "timer", TRUE, FALSE) # Restart the timer. #
      )
   OUT
      put(stand error, ("Expected a timer. Got something else!", new line))
   ESAC;
   FALSE
);

# Handle time zone selection events. #
PROC lab_proc = (STRING tag, STRING event, ANYBUTTONREF state) BOOL:
(
   IF event[1] = "D"
   THEN
      CASE state
      IN
         (REF RADIOBUTTON rb): (
            STRING selected_label := get_radiobutton_sel_label(rb);
            IF selected_label = "Local"
            THEN
               local := TRUE;
               set_hms(delta, 0, 0, 0, 0)
            ELIF selected_label = "UTC"
            THEN
               local := FALSE;
               set_hms(delta, 0, 0, 0, 0)
            ELSE
               INT delta_hours := config_get_int_value(cp, "cities."+selected_label, 0);
               local := FALSE;
               set_hms(delta, 0, delta_hours, 0, 0)
            FI
         )
      OUT
         put(stand error, ("Expected a radio button. Got something else!", new line))
      ESAC
   FI;
   FALSE
);

# ============ #
# MAIN PROGRAM #
# ============ #

print_std_title("Simple Clock. V0.1");

# Define, get and parse command line arguments. These MUST appear after --. #
REF ARG_PARSE arg_parser := make_arg_parser("Simple Clock Program");
arg_set_description(arg_parser,
"This is a simple clock display program that shows some of the features\n\
of the VCPGUI project. It can display the local time, UTC time, or the time\n\
at one of a three cities. These can be defined in `clock-cities.ini`, along\n\
with UTC time offsets. No attempt is made to use system timezone and DST data\n\
as that would take too much effort from Algol 68!");
REF BOOL ontop := arg_add_flag(arg_parser, "-o", "--ontop",
                               "Keep DSURF window on top.",
                               FALSE);
REF BOOL nodecor := arg_add_flag(arg_parser, "-n", "--noborder",
                                 "Turn off window border for DSURF.",
                                 FALSE);
REF STRING audiofile := arg_add_string_option(arg_parser, "-a", "--audiofile",
                                              "Specify the name of the audio file for button clicks.",
                                              get env("HOME") + "/.config/vcpgui68/clicky.wav");
( NOT parse_args(arg_parser) |
      put(stand error, ("Unknown or malformed command line arguments.", new line)); 
      stop );

# Parse the configuration file. #
REF CONFIG_PARSE cp := make_config_parser("clock-cities.ini");
(NOT parse_config_file(cp) | 
      put(stand error, ("Failed to parse config file. Giving up.", newline));
      stop);
(NOT config_has_table(cp, "cities") | 
      put(stand error, ("Expected cities table in config file. Giving up.", newline));
      stop);

STRING cities_list := "";
FLEX [1:0] STRING city_names := config_get_keys_in_table(cp, "cities", TRUE);
FOR i TO min2int(3, ELEMS city_names)
DO
   CO print((wint(i)," ",city_names[i],newline)); CO
   (i > 1 | cities_list +:= ",");
   cities_list +:= city_names[i]
OD;
IF ELEMS city_names < 3
THEN
   FOR i FROM (ELEMS city_names) TO 3
   DO
      cities_list +:= ("," + "--" + wint(i))
   OD
FI;

# Update display only when show_display commands are sent. Reduces 'flashing' on time updates. #
BOOL immediate_update := config_get_bool_value(cp, "immediate-update", FALSE);
 
# Open and configure the GUI display surface. #
INT width := 386, height := 130;
ds_config_set_fast_update(immediate_update);
ds_config_set_on_top(ontop);
ds_config_set_no_border(nodecor);
ds_config_set_click_audio(audiofile);
PIPE gui := open_gui("Clock", width, height);

# Get current local time. #
HMSTIME itime := get_time_of_day(FALSE);

# Add a timer, expiring each second. #
add_timer("timer", tick_proc, 1000);

# Time display. #
INT margin = 10;
ui_colour(gui, "feature");
add_timedisplay_hms("display", width%2, 65, itime);
move_component("display", "tl", margin, margin);

# Buttons, centered on time display. #
GEOMETRY td_geometry;
get_geometry("display", td_geometry);
print_geometry(td_geometry);

# Keep a current y position. Adjust to move between rows. #
INT y := yc OF td_geometry + (height OF td_geometry % 2) + (vertical_spacing_buttons(FALSE) % 2);

[]INT row1_button_counts = (5,1);
INT but_width, but_height;
get_dimensions_pushbutton(but_width, but_height);
BOOL too_wide;
FLEX [1:0]INT centers := evenly_distribute(td_geometry, row1_button_counts, but_width, TRUE, too_wide);

# Location radiobutton. #
ui_colour_base_font(gui, "button");
add_radiobutton("location", 
                "Local,UTC," + cities_list,
                lab_proc, centers[1], y, 1);

# Power off button ...  #
ui_colour(gui, "warning");
add_pushbutton("off", "OFF", quit_proc, centers[2], y);

#  Start the timer. #
set_timer(gui, "timer", TRUE, FALSE);

# Create and run the GUI. #
instantiate(gui);
run_event_loop(gui);

# Shut down. #
end:
close_dsurf(gui)
